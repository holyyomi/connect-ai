# YOMI AI personal office environment example
# Copy the keys you use into .env. Do not commit real secrets.

PORT=17331
YOMI_AI_PERSONAL_VAULT=C:\Users\a0104\Desktop\MY\obsidian

# CLI engines
YOMI_AI_CODEX_COMMAND=codex
YOMI_AI_CODEX_TIMEOUT_MS=600000
YOMI_AI_CODEX_PROMPT_TIMEOUT_MS=120000
YOMI_AI_CLAUDE_COMMAND=claude
YOMI_AI_CLAUDE_MODEL=
YOMI_AI_CLAUDE_PROMPT_TIMEOUT_MS=180000
YOMI_AI_CLAUDE_MAX_BUDGET_USD=0.25

# Optional semantic RAG embeddings. Set exactly one provider key.
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3-lite
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-multilingual-v3.0

# Optional research APIs. BRAVE is intentionally excluded.
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
