    },
    {
      "id": "claude_cli",
      "name": "Claude Code CLI",
      "kind": "model",
      "provider": "claude-code",
      "enabled": true,
      "envKeys": [
        "YOMI_AI_CLAUDE_COMMAND",
        "YOMI_AI_CLAUDE_MODEL"
      ],
      "mcpServer": "",
      "install": "",
      "safeMode": true,
      "allowedActions": [
        "manual_chat",
        "auto_route",
        "plan",
        "synthesis",
        "review"
      ],
      "blockedActions": [
        "file_write",
        "git_write",
        "external_send"
      ],
      "scope": null,
      "notes": "긴 추론, 글쓰기, 리서치 종합, 검토 업무에 자동 라우팅될 수 있습니다. 실패 시 Codex CLI로 엔진 폴백합니다."
    },
    {
      "id": "obsidian_vault",
      "name": "Obsidian Vault",
      "kind": "storage",
      "provider": "filesystem",
      "enabled": true,
      "envKeys": [
        "YOMI_AI_PERSONAL_VAULT"
      ],
      "mcpServer": "",
      "install": "",
      "safeMode": false,
      "allowedActions": [],
      "blockedActions": [],
      "scope": null,
      "notes": "마크다운 저장소 경로입니다."
    },
    {
      "id": "context7_mcp",
      "name": "Context7 MCP",
      "kind": "mcp",
      "provider": "context7",
      "enabled": true,
      "envKeys": [],
      "mcpServer": "context7",
      "install": "npx -y @upstash/context7-mcp@latest",
      "safeMode": true,
      "allowedActions": [
        "resolve-library-id",
        "get-library-docs"
      ],
      "blockedActions": [
        "write",
        "external_send"
      ],
      "scope": {
        "purpose": "library-docs",
        "requiresApiKey": false
      },
      "notes": "태오용 최신 라이브러리 문서 조회입니다. API 키 없이 제한적으로 사용합니다."
    },
    {
      "id": "playwright_mcp",
      "name": "Playwright MCP",
      "kind": "mcp",
      "provider": "playwright",
      "enabled": true,
      "envKeys": [],
      "mcpServer": "playwright",
      "install": "npx -y @playwright/mcp@latest --isolated",
      "safeMode": true,
      "allowedActions": [
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_screenshot"
      ],
      "blockedActions": [
        "external_send",
        "file_write"
      ],
      "scope": {
        "browser": "isolated",
        "requiresConfirmation": true
      },
      "notes": "브라우저 자동화 후보입니다. 화면 제어 권한이 있어 실제 실행은 사용자 확인 후 진행합니다."
    },
    {
      "id": "exa_mcp",
      "name": "Exa MCP",
      "kind": "api",
      "provider": "exa",
      "enabled": true,
      "envKeys": [
        "EXA_API_KEY"
      ],
      "mcpServer": "exa",
      "install": "npx -y exa-mcp-server",
      "safeMode": true,
      "allowedActions": [
        "semantic_search"
      ],
      "blockedActions": [
        "write",
        "external_send"
      ],
      "scope": {
        "purpose": "semantic-search",
        "requiresApiKey": true
      },
      "notes": "시맨틱 검색 후보입니다. EXA_API_KEY를 .env에 넣으면 정상 연결됩니다."
    },
    {
      "id": "firecrawl_mcp",
      "name": "Firecrawl MCP",
      "kind": "api",
      "provider": "firecrawl",
      "enabled": true,
      "envKeys": [
        "FIRECRAWL_API_KEY"
      ],
      "mcpServer": "firecrawl",
      "install": "npx -y firecrawl-mcp",
      "safeMode": true,
      "allowedActions": [
        "scrape",
        "extract"
      ],
      "blockedActions": [
        "write",
        "external_send"
      ],
      "scope": {
        "purpose": "web-scrape-extract",
        "requiresApiKey": true
      },
      "notes": "웹 본문 추출/크롤링 후보입니다. FIRECRAWL_API_KEY를 .env에 넣으면 정상 연결됩니다."
    },
    {
      "id": "fetch_mcp",
      "name": "Fetch MCP",
      "kind": "mcp",
      "provider": "fetch",
      "enabled": true,
      "envKeys": [],
      "mcpServer": "fetch",
      "install": "uvx mcp-server-fetch",
      "safeMode": true,
      "allowedActions": [
        "fetch_url",
        "extract_text"
      ],
      "blockedActions": [
        "post",
        "upload",
        "submit_form"
      ],
      "scope": {
        "network": "read-only-http",
        "requiresUserUrl": true
      },
      "notes": "웹페이지 본문 읽기 후보입니다. uvx 설치 상태를 확인해 연결 가능 여부를 표시합니다."
    },
    {
      "id": "git_mcp",
      "name": "Git MCP",
      "kind": "mcp",
      "provider": "git",
      "enabled": true,
      "envKeys": [],
      "mcpServer": "git",
      "install": "uvx mcp-server-git",
      "safeMode": true,
      "allowedActions": [
        "status",
        "diff",
        "log"
      ],
      "blockedActions": [
        "add",
        "commit",
        "push",
        "reset",
        "checkout",
        "rebase",
        "clean"
      ],
      "scope": {
        "repository": "current-workspace",
        "write": false
      },
      "notes": "태오용 Git 읽기 전용 후보입니다. Git 쓰기는 사용자 확인 없이는 허용하지 않습니다."
    },
    {
      "id": "tavily_search",
      "name": "Tavily Search",
      "kind": "api",
      "provider": "tavily",
      "enabled": true,
      "envKeys": [
        "TAVILY_API_KEY"
      ],
      "mcpServer": "tavily",
      "install": "npx -y tavily-mcp",
      "safeMode": true,
      "allowedActions": [
        "search"
      ],
      "blockedActions": [
        "write",
        "external_send"
      ],
      "scope": {
        "purpose": "optional-search-fallback",
        "required": false
      },
      "notes": "검색 백업 후보입니다. TAVILY_API_KEY를 .env에 넣으면 정상 연결됩니다."
    },
    {
      "id": "filesystem",
